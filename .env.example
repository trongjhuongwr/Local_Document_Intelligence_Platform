# Copy to .env and adjust as needed. All values shown are the defaults.

ENVIRONMENT=development
LOG_LEVEL=INFO

API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL (docker compose up -d postgres)
# POSTGRES_PORT controls the host port mapping in docker-compose; change both if 5432 is taken.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docintel:docintel@localhost:5432/docintel

# Ollama runs on the Windows/host machine, not inside Docker
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=all-minilm
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=120

ENABLE_RERANKER=false
# LLM-assisted routing is off by default: measured less accurate than the
# deterministic keyword router on this domain (see evals/reports/routing_latest.md)
ROUTER_LLM_ENABLED=false

MAX_UPLOAD_SIZE_MB=25
